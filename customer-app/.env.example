# Note: Customer app communicates with the Supabase Edge Function BFF.
# DO NOT include any Supabase service-role keys here.
#
# Environment selector: 'local' (Docker) or 'hosted' (production/staging Supabase)
EXPO_PUBLIC_APP_ENV=hosted

# --- HOSTED SUPABASE CONFIGURATION ---
EXPO_PUBLIC_HOSTED_SUPABASE_URL=https://yjpbswsgtbmgageburmy.supabase.co
EXPO_PUBLIC_HOSTED_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_HOSTED_BFF_BASE_URL=https://yjpbswsgtbmgageburmy.supabase.co/functions/v1

# --- LOCAL DOCKER CONFIGURATION ---
EXPO_PUBLIC_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_LOCAL_SUPABASE_ANON_KEY=your-local-anon-key-here
EXPO_PUBLIC_LOCAL_BFF_BASE_URL=http://127.0.0.1:54321/functions/v1

# Backward-compatibility fallbacks
EXPO_PUBLIC_SUPABASE_URL=https://yjpbswsgtbmgageburmy.supabase.co
