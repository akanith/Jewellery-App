# =============================================================================
# RAMYAS JEWELLER - Admin Web Environment Variables Template
# =============================================================================
# DO NOT commit .env.local to version control.
# Copy this file to .env.local and configure your environment.

# Active backend switch: 'local' (local Supabase Docker) or 'hosted' (production)
NEXT_PUBLIC_APP_ENV=local

# Local Supabase settings
NEXT_PUBLIC_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_LOCAL_SUPABASE_ANON_KEY=your-local-supabase-anon-key

# Hosted Supabase settings
NEXT_PUBLIC_HOSTED_SUPABASE_URL=https://yjpbswsgtbmgageburmy.supabase.co
NEXT_PUBLIC_HOSTED_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Default fallback
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-anon-key
