# Supabase Public Configuration
# Used by Admin Web App and Customer Mobile App
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# IMPORTANT:
# 1. Do NOT put service-role keys in client-side applications.
# 2. Copy this file to .env.local for local Admin Web development.
# 3. Do NOT commit actual .env or secret files to Git.
