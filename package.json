{
  "name": "ramyas-jeweller-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ramyas Jeweller Savings Scheme Management System Monorepo",
  "workspaces": [
    "apps/admin-web",
    "apps/app",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "dev:app": "npm run start --workspace=apps/app",
    "build:admin": "npm run build --workspace=apps/admin-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  }
}